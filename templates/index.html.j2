<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PS-0 Market Reports — Nigerian Property Research</title><meta name="description" content="Read PS-0 market reports on advertised Nigerian property: inventory, asking prices and price adjustments, with transparent coverage and methodology."><link rel="canonical" href="https://reports.akinmokun.com/"><link rel="icon" href="/favicon.ico"><meta property="og:title" content="PS-0 Market Reports"><meta property="og:description" content="A considered view of advertised Nigerian property markets. Research by Isaac Akinmokun."><meta property="og:type" content="website"><meta property="og:url" content="https://reports.akinmokun.com/"><meta property="og:image" content="https://reports.akinmokun.com/social-card.png"><meta name="twitter:card" content="summary_large_image"><script type="application/ld+json">{{ collection_schema | tojson }}</script><style>{{ embedded_fonts_css | safe }}{% include 'partials/site.css' %}</style><script>{% include 'partials/theme.js' %}</script></head><body><div class="shell">{% include 'partials/header.html.j2' %}<main id="main-content"><section class="hero"><div><span class="eyebrow">The PS-0 research series</span><h1>A closer reading of<br>Nigerian property.</h1><p>Market reports on the listings observed by PS-0. Follow advertised inventory, compare asking prices, and understand where sellers are adjusting their expectations.</p></div><aside><span class="eyebrow">Observation, with context</span><p>Independent research by <a href="https://akinmokun.com/">Isaac Akinmokun</a>. Each issue documents its source, coverage, and limitations.</p><a href="https://ps0.akinmokun.com/">Explore the platform ↗</a></aside></section>
{% if reports %}{% set latest=reports[0] %}<section class="featured" aria-labelledby="latest-title"><div class="issue-cover" aria-hidden="true"><span class="eyebrow" style="color:#e5c38b">PS-0 / Research</span><strong>Nigerian<br>property<br>markets</strong><small>{{ latest.label }}</small></div><div><span class="eyebrow">Latest publication · {{ latest.period }}</span><h2 id="latest-title">{{ latest.label }}</h2><p class="muted">Inventory, asking prices and price adjustments across {{ latest.cities }} cities and {{ latest.neighbourhoods }} observed neighbourhoods.</p><p class="count">Published {{ latest.published }} · {{ latest.type | replace('all','Sales & rentals') }}</p><div class="actions"><a class="button primary" href="/{{ latest.month }}/">Read the report →</a>{% if latest.has_pdf %}<a class="button" href="/{{ latest.month }}/{{ latest.pdf_name }}" download>Download PDF ↓</a>{% endif %}</div></div></section>{% endif %}
<section aria-labelledby="archive-title"><div class="section-heading"><h2 id="archive-title">Publication archive</h2><span class="count" id="result-count" aria-live="polite">{{ reports|length }} publications</span></div><div class="filters" hidden id="filters"><label>Search publications<input id="search" type="search" placeholder="Month or year…"></label><label>Market<select id="market"><option value="">All markets</option><option value="all">Sales & rentals</option><option value="sale">Sales</option><option value="rent">Rentals</option></select></label><label>Period<select id="period"><option value="">All periods</option><option value="1mo">Monthly</option><option value="3mo">Three months</option><option value="6mo">Six months</option><option value="12mo">Annual</option></select></label></div>
{% for report in reports %}<article class="publication" data-search="{{ report.label | lower }}" data-market="{{ report.type }}" data-period="{{ report.period }}"><time>{{ report.published }}</time><div><h3><a href="/{{ report.month }}/">{{ report.label }}</a></h3><p>{{ report.cities }} cities · {{ report.neighbourhoods }} neighbourhoods · {{ report.period }} · {{ 'Sales & rentals' if report.type=='all' else report.type|title }}</p></div><div class="actions"><a class="button" href="/{{ report.month }}/" aria-label="Read {{ report.label }}">Read →</a>{% if report.has_pdf %}<a class="button" href="/{{ report.month }}/{{ report.pdf_name }}" aria-label="Download {{ report.label }} PDF">PDF ↓</a>{% endif %}</div></article>{% endfor %}<p id="empty" hidden>No publications match these filters.</p></section></main>{% include 'partials/footer.html.j2' %}</div><script>document.getElementById('filters').hidden=false;const fields=['search','market','period'].map(id=>document.getElementById(id));function filter(){let count=0;document.querySelectorAll('.publication').forEach(row=>{row.hidden=!(row.dataset.search.includes(fields[0].value.toLowerCase().trim())&&(!fields[1].value||row.dataset.market===fields[1].value)&&(!fields[2].value||row.dataset.period===fields[2].value));if(!row.hidden)count++});document.getElementById('result-count').textContent=count+' publications';document.getElementById('empty').hidden=count!==0}fields.forEach(field=>field.addEventListener('input',filter));</script></body></html>
