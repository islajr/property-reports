{% set base='https://akinmokun.com' %}
<header class="site-header">
<a href="#main-content" class="skip-link">Skip to content</a>
<details class="app-switcher" data-site-disclosure><summary aria-label="Site directory"><span class="wordmark"><img src="/isaac-akinmokun-apple-touch-icon.png" width="24" height="24" alt="">isaac<span class="switch-chevron" aria-hidden="true">↕</span></span></summary>
<nav class="apps-panel" aria-label="Site directory">
{% for label, links in [
('Personal', [('Home',base+'/', 'Profile & selected work','IA','blue'),('Blog',base+'/blog/','Docs, essays & research','B','purple'),('Now',base+'/now/','Current focus','N','orange'),('Photos',base+'/photos/','Photography & grading','PH','rose'),('Protocol',base+'/protocol/','A personal operating system','P','teal')]),
('Systems',[('Projects',base+'/projects/','Tools & experiments','PR','blue'),('Homelab',base+'/homelab/','Setup & infrastructure plans','HL','teal'),('PropertyScraper','https://ps0.akinmokun.com/','Property data pipeline','PS','green'),('Market reports','/','Real estate intelligence','R','orange')]),
('Connect',[('About',base+'/about/','Background & experience','A','purple'),('Credentials',base+'/credentials/','CVs & documents','CV','blue'),('GitHub','https://github.com/islajr','Source code & contributions','GH','neutral'),('Email','mailto:isaac@akinmokun.com','Say hello','@','rose')])
] %}<div class="apps-group"><p class="menu-label">{{ label }}</p>{% for name, href, description, mark, tone in links %}<a class="app-link" data-tone="{{ tone }}" href="{{ href }}"{% if href=='/' %} aria-current="page"{% endif %}><span class="app-mark" aria-hidden="true">{{ mark }}</span><span><strong>{{ name }}</strong><small>{{ description }}</small></span></a>{% endfor %}</div>{% endfor %}</nav></details>
<nav class="site-nav" aria-label="Main navigation">{% for name,path in [('Home','/'),('Projects','/projects/'),('About','/about/'),('Blog','/blog/')] %}<a href="{{ base }}{{ path }}">{{ name }}</a>{% endfor %}<details class="site-more" data-site-disclosure><summary>Explore</summary><div class="more-links">{% for name,path in [('Now','/now/'),('Homelab','/homelab/'),('Photos','/photos/'),('Protocol','/protocol/'),('Credentials / CV','/credentials/')] %}<a href="{{ base }}{{ path }}">{{ name }}</a>{% endfor %}<a href="/" aria-current="page">Market reports ↗</a></div></details></nav>
<div class="header-actions"><a class="header-cv" href="{{ base }}/credentials/">CV ↗</a><button type="button" class="theme-toggle" role="switch" aria-label="Dark appearance" aria-checked="false"><span class="theme-orb" aria-hidden="true"></span><span class="theme-light-label" aria-hidden="true">Light</span><span class="theme-dark-label" aria-hidden="true">Dark</span></button></div></header>
